            "url": {
              "raw": "{{baseUrl}}?page=0&size=20&sortBy=createdAt&sortDir=DESC&includeSkus=true",
              "host": ["{{baseUrl}}"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "sortBy",
                  "value": "createdAt"
                },
                {
                  "key": "sortDir",
                  "value": "DESC"
                },
                {
                  "key": "includeSkus",
