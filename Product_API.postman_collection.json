{
  "info": {
    "name": "Product API - Complete Test Collection",
    "description": "Postman collection cho testing Product API - CRUD, Public endpoints, và Elasticsearch Search",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8086/api/products",
      "type": "string"
    },
    {
      "key": "publicBaseUrl",
      "value": "http://localhost:8086/api/products/public",
      "type": "string"
    },
    {
      "key": "searchBaseUrl",
      "value": "http://localhost:8086/api/products/search",
      "type": "string"
    },
    {
      "key": "sellerToken",
      "value": "your_seller_token_here",
      "type": "string"
    },
    {
      "key": "superAdminToken",
      "value": "your_super_admin_token_here",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "storeId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "CREATE",
      "item": [
        {
          "name": "1. Tạo sản phẩm vật lý với 1 SKU",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.id) {",
                  "        pm.collectionVariables.set('productId', jsonData.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productName\": \"Áo thun nam cổ tròn\",\n  \"productCode\": \"PROD-001\",\n  \"slug\": \"ao-thun-nam-co-tron\",\n  \"description\": \"Áo thun nam chất liệu cotton 100%, thoáng mát, dễ giặt\",\n  \"shortDescription\": \"Áo thun nam cotton 100%\",\n  \"productType\": \"PHYSICAL\",\n  \"categoryId\": {{categoryId}},\n  \"storeCategoryId\": 1,\n  \"isCombo\": false,\n  \"ocopCertified\": false,\n  \"hasOriginTracking\": false,\n  \"skus\": [\n    {\n      \"sku\": \"SKU-001\",\n      \"variantName\": \"Áo thun - Size M\",\n      \"size\": \"M\",\n      \"color\": \"Trắng\",\n      \"material\": \"Cotton\",\n      \"price\": 150000,\n      \"comparePrice\": 200000,\n      \"costPrice\": 100000,\n      \"stockQuantity\": 100,\n      \"imageUrl\": \"https://example.com/images/ao-thun-m-trang.jpg\",\n      \"weightKg\": 0.2,\n      \"lengthCm\": 70,\n      \"widthCm\": 50,\n      \"heightCm\": 2,\n      \"status\": \"active\",\n      \"displayOrder\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          }
        },
        {
          "name": "2. Tạo sản phẩm vật lý với nhiều SKU",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productName\": \"Áo thun nam cổ tròn - Multi SKU\",\n  \"productType\": \"PHYSICAL\",\n  \"categoryId\": {{categoryId}},\n  \"skus\": [\n    {\n      \"sku\": \"SKU-002-M\",\n      \"variantName\": \"Áo thun - Size M - Trắng\",\n      \"size\": \"M\",\n      \"color\": \"Trắng\",\n      \"price\": 150000,\n      \"stockQuantity\": 50,\n      \"status\": \"active\"\n    },\n    {\n      \"sku\": \"SKU-002-L\",\n      \"variantName\": \"Áo thun - Size L - Trắng\",\n      \"size\": \"L\",\n      \"color\": \"Trắng\",\n      \"price\": 150000,\n      \"stockQuantity\": 50,\n      \"status\": \"active\"\n    },\n    {\n      \"sku\": \"SKU-002-M-RED\",\n      \"variantName\": \"Áo thun - Size M - Đỏ\",\n      \"size\": \"M\",\n      \"color\": \"Đỏ\",\n      \"price\": 150000,\n      \"stockQuantity\": 30,\n      \"status\": \"active\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          }
        },
        {
          "name": "3. Tạo sản phẩm khóa học (DIGITAL)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productName\": \"Khóa học lập trình Java cơ bản\",\n  \"productType\": \"DIGITAL\",\n  \"categoryId\": 2,\n  \"description\": \"Khóa học lập trình Java từ cơ bản đến nâng cao\",\n  \"shortDescription\": \"Khóa học Java cơ bản\",\n  \"durationHours\": 40,\n  \"accessPeriodDays\": 365,\n  \"isUnlimitedAccess\": false,\n  \"deliveryMethod\": \"online_access\",\n  \"skus\": [\n    {\n      \"sku\": \"COURSE-JAVA-001\",\n      \"variantName\": \"Khóa học Java - Gói cơ bản\",\n      \"price\": 2000000,\n      \"comparePrice\": 3000000,\n      \"stockQuantity\": 999,\n      \"status\": \"active\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          }
        },
        {
          "name": "4. Tạo sản phẩm OCOP certified",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productName\": \"Mật ong rừng nguyên chất\",\n  \"productType\": \"PHYSICAL\",\n  \"categoryId\": 3,\n  \"ocopCertified\": true,\n  \"ocopLevel\": \"3 sao\",\n  \"isVerified\": true,\n  \"hasOriginTracking\": true,\n  \"skus\": [\n    {\n      \"sku\": \"HONEY-500G\",\n      \"variantName\": \"Mật ong - 500g\",\n      \"weightVariant\": \"500g\",\n      \"price\": 150000,\n      \"stockQuantity\": 100,\n      \"status\": \"active\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          }
        },
        {
          "name": "5. Tạo sản phẩm không có SKU (Error)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productName\": \"Sản phẩm không có SKU\",\n  \"productType\": \"PHYSICAL\",\n  \"skus\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          }
        }
      ]
    },
    {
