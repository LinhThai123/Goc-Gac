            "url": {
              "raw": "{{baseUrl}}?keyword=áo thun&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "query": [
                {
                  "key": "keyword",
                  "value": "áo thun"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "5. Lấy thông tin chi tiết sản phẩm",
          "request": {
