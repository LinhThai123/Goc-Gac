{
  "info": {
    "name": "Category API - CRUD Tests",
    "description": "Postman collection cho testing Category API (public + admin).\n\nPublic: /public, /public/tree, /public/slug/{slug}, /public/roots, /public/parent/{parentId}/children\nAdmin: CRUD + /roots, /{parentId}/children\n\nBiến: baseUrl, adminToken, categoryId, parentId, categorySlug",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/categories",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "your_admin_token_here",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "parentId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "categorySlug",
      "value": "dien-tu",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "CREATE",
      "item": [
        {
          "name": "1. Tạo root category - Điện tử",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryName\": \"Điện tử\",\n  \"categorySlug\": \"dien-tu\",\n  \"description\": \"Danh mục các sản phẩm điện tử, công nghệ\",\n  \"imageUrl\": \"https://example.com/images/dien-tu.jpg\",\n  \"displayOrder\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          }
        },
        {
          "name": "2. Tạo root category - Thời trang (auto slug)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryName\": \"Thời trang\",\n  \"description\": \"Danh mục thời trang nam nữ\",\n  \"imageUrl\": \"https://example.com/images/thoi-trang.jpg\",\n  \"displayOrder\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          }
        },
        {
          "name": "3. Tạo child category - Điện thoại",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryName\": \"Điện thoại\",\n  \"categorySlug\": \"dien-thoai\",\n  \"parentId\": {{parentId}},\n  \"description\": \"Danh mục điện thoại smartphone\",\n  \"displayOrder\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          }
        },
        {
          "name": "4. Tạo category tối thiểu",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryName\": \"Sách\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          }
        },
        {
          "name": "ERROR: categoryName rỗng",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryName\": \"\",\n  \"categorySlug\": \"test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          }
        },
        {
          "name": "ERROR: slug không hợp lệ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryName\": \"Test Category\",\n  \"categorySlug\": \"test_slug_invalid\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          }
        }
      ]
    },
    {
      "name": "READ - Public",
      "item": [
        {
          "name": "1. Lấy active categories (flat)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public",
              "host": ["{{baseUrl}}"],
              "path": ["public"]
            },
            "description": "GET /api/categories/public — danh sách phẳng, chỉ active, sort displayOrder"
          }
        },
        {
          "name": "2. Lấy cây danh mục active (tree)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public/tree",
              "host": ["{{baseUrl}}"],
              "path": ["public", "tree"]
            },
            "description": "GET /api/categories/public/tree — root kèm children lồng nhau trong field `children`"
          }
        },
        {
          "name": "3. Lấy category active theo slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public/slug/{{categorySlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["public", "slug", "{{categorySlug}}"]
            },
            "description": "GET /api/categories/public/slug/{slug} — chỉ category active; inactive → 404"
          }
        },
        {
          "name": "4. Lấy root categories active",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public/roots",
              "host": ["{{baseUrl}}"],
              "path": ["public", "roots"]
            },
            "description": "GET /api/categories/public/roots — parent_id = null, isActive = true"
          }
        },
        {
          "name": "5. Lấy child categories active",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public/parent/{{parentId}}/children",
              "host": ["{{baseUrl}}"],
              "path": ["public", "parent", "{{parentId}}", "children"]
            },
            "description": "GET /api/categories/public/parent/{parentId}/children — parent phải tồn tại và active"
          }
        },
        {
          "name": "ERROR: Slug không tồn tại hoặc inactive",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public/slug/khong-ton-tai",
              "host": ["{{baseUrl}}"],
              "path": ["public", "slug", "khong-ton-tai"]
            },
            "description": "Kỳ vọng 404"
          }
        },
        {
          "name": "ERROR: Parent không tồn tại (children)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public/parent/99999/children",
              "host": ["{{baseUrl}}"],
              "path": ["public", "parent", "99999", "children"]
            },
            "description": "Kỳ vọng 404"
          }
        }
      ]
    },
    {
      "name": "READ - Admin",
      "item": [
        {
          "name": "1. Lấy tất cả categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            },
            "description": "GET /api/categories — gồm cả inactive, yêu cầu ADMIN/SUPER_ADMIN"
          }
        },
        {
          "name": "2. Lấy root categories (admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/roots",
              "host": ["{{baseUrl}}"],
              "path": ["roots"]
            },
            "description": "GET /api/categories/roots — gồm cả inactive"
          }
        },
        {
          "name": "3. Lấy child categories (admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{parentId}}/children",
              "host": ["{{baseUrl}}"],
              "path": ["{{parentId}}", "children"]
            },
            "description": "GET /api/categories/{parentId}/children — gồm cả inactive"
          }
        },
        {
          "name": "4. Lấy category theo ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{categoryId}}"]
            },
            "description": "GET /api/categories/{id}"
          }
        },
        {
          "name": "ERROR: ID không tồn tại",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/99999",
              "host": ["{{baseUrl}}"],
              "path": ["99999"]
            },
            "description": "Kỳ vọng 404"
          }
        },
        {
          "name": "ERROR: Parent không tồn tại (admin children)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/99999/children",
              "host": ["{{baseUrl}}"],
              "path": ["99999", "children"]
            },
            "description": "Kỳ vọng 404"
          }
        }
      ]
    },
    {
      "name": "UPDATE",
      "item": [
        {
          "name": "1. Cập nhật tất cả các trường",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryName\": \"Điện tử - Đã cập nhật\",\n  \"categorySlug\": \"dien-tu-cap-nhat\",\n  \"description\": \"Mô tả đã được cập nhật\",\n  \"imageUrl\": \"https://example.com/images/dien-tu-new.jpg\",\n  \"displayOrder\": 10,\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{categoryId}}"]
            }
          }
        },
        {
          "name": "2. Cập nhật chỉ categoryName",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryName\": \"Điện tử - Tên mới\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{categoryId}}"]
            }
          }
        },
        {
          "name": "3. Cập nhật parentId",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parentId\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/3",
              "host": ["{{baseUrl}}"],
              "path": ["3"]
            }
          }
        },
        {
          "name": "4. Deactivate category",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{categoryId}}"]
            },
            "description": "Sau khi deactivate, GET public/slug và public/children sẽ 404 với category này"
          }
        },
        {
          "name": "ERROR: Category không tồn tại",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryName\": \"Test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/99999",
              "host": ["{{baseUrl}}"],
              "path": ["99999"]
            }
          }
        },
        {
          "name": "ERROR: parentId là chính nó",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parentId\": {{categoryId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{categoryId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "DELETE",
      "item": [
        {
          "name": "1. Xóa category (soft delete)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/5",
              "host": ["{{baseUrl}}"],
              "path": ["5"]
            },
            "description": "Leaf category, không có con active, không có sản phẩm gắn categoryId"
          }
        },
        {
          "name": "ERROR: Category có con active",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{parentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{parentId}}"]
            },
            "description": "Kỳ vọng 400 khi còn category con active"
          }
        },
        {
          "name": "ERROR: Category còn sản phẩm",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{categoryId}}"]
            },
            "description": "Kỳ vọng 400 khi còn sản phẩm dùng categoryId này"
          }
        },
        {
          "name": "ERROR: Category không tồn tại",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/99999",
              "host": ["{{baseUrl}}"],
              "path": ["99999"]
            }
          }
        }
      ]
    }
  ]
}
