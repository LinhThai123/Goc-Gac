	"item": [
		{
			"name": "Create Store Category",
			"item": [
				{
					"name": "Create Root Category",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response has category data\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('id');",
									"    pm.expect(jsonData.data.parentId).to.be.null;",
									"    pm.expect(jsonData.data.level).to.eql(1);",
									"});",
									"",
									"// Save category ID for later use",
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"root_category_id\", jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"categoryName\": \"Hàng mới về\",\n  \"parentId\": null,\n  \"description\": \"Danh mục hàng mới về\",\n  \"displayOrder\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/store-categories",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"store-categories"
							]
						},
						"description": "Tạo root store category (parentId = null)"
					},
					"response": []
				},
				{
					"name": "Create Child Category",
