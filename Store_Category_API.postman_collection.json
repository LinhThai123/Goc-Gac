									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response has child category data\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('id');",
									"    pm.expect(jsonData.data.parentId).to.not.be.null;",
									"    pm.expect(jsonData.data.level).to.be.above(1);",
									"});",
									"",
									"// Save child category ID",
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"child_category_id\", jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
