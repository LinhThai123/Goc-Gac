{
  "info": {
    "name": "Channel API - CRUD Tests",
    "description": "Postman collection cho testing Channel API (micro-site shop).\n\nPublic: GET /, GET /featured, GET /{slug}\nProtected (COOPERATIVE_MANAGER, SELLER): GET /my-channel, POST, PUT /{id}, DELETE /{id}\n\nLưu ý: Mỗi store chỉ được 1 channel. Slug unique toàn hệ thống.\n\nBiến: baseUrl, sellerToken, channelId, channelSlug",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/channels",
      "type": "string"
    },
    {
      "key": "sellerToken",
      "value": "your_seller_or_cooperative_manager_token_here",
      "type": "string"
    },
    {
      "key": "channelId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "channelSlug",
      "value": "htx-moc-chau",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "READ - Public",
      "item": [
        {
          "name": "1. Lấy tất cả channels active",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            },
            "description": "GET /api/channels — danh sách channel isActive = true, không cần token"
          }
        },
        {
          "name": "2. Lấy channels featured",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/featured",
              "host": ["{{baseUrl}}"],
              "path": ["featured"]
            },
            "description": "GET /api/channels/featured — isFeatured = true và isActive = true"
          }
        },
        {
          "name": "3. Lấy channel theo slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{channelSlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{channelSlug}}"]
            },
            "description": "GET /api/channels/{slug} — chỉ channel active; inactive → 404"
          }
        },
        {
          "name": "ERROR: Slug không tồn tại hoặc inactive",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/slug-khong-ton-tai",
              "host": ["{{baseUrl}}"],
              "path": ["slug-khong-ton-tai"]
            },
            "description": "Kỳ vọng 404"
          }
        }
      ]
    },
    {
      "name": "READ - Protected",
      "item": [
        {
          "name": "1. Lấy channel của tôi (my-channel)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/my-channel",
              "host": ["{{baseUrl}}"],
              "path": ["my-channel"]
            },
            "description": "GET /api/channels/my-channel — channel của store gắn với user đăng nhập"
          }
        },
        {
          "name": "ERROR: Chưa có channel (hoặc chưa có store)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/my-channel",
              "host": ["{{baseUrl}}"],
              "path": ["my-channel"]
            },
            "description": "Kỳ vọng 404 khi store chưa tạo channel"
          }
        },
        {
          "name": "ERROR: Không có token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/my-channel",
              "host": ["{{baseUrl}}"],
              "path": ["my-channel"]
            },
            "description": "Kỳ vọng 401/403 tùy cấu hình security"
          }
        }
      ]
    },
    {
      "name": "CREATE",
      "item": [
        {
          "name": "1. Tạo channel đầy đủ thông tin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channelSlug\": \"{{channelSlug}}\",\n  \"channelName\": \"HTX Mộc Châu\",\n  \"shortDescription\": \"Nông sản sạch từ Mộc Châu\",\n  \"description\": \"<p>Giới thiệu chi tiết về HTX và sản phẩm đặc sản.</p>\",\n  \"bannerUrl\": \"https://example.com/images/banner.jpg\",\n  \"logoUrl\": \"https://example.com/images/logo.png\",\n  \"videoUrl\": \"https://example.com/videos/intro.mp4\",\n  \"storyContent\": \"<p>Câu chuyện thương hiệu...</p>\",\n  \"originStory\": \"<p>Nguồn gốc sản phẩm...</p>\",\n  \"themeSettings\": \"{\\\"primaryColor\\\": \\\"#2E7D32\\\", \\\"secondaryColor\\\": \\\"#FFC107\\\", \\\"logo\\\": \\\"https://example.com/logo.png\\\"}\",\n  \"metaTitle\": \"HTX Mộc Châu - Gốc Gác\",\n  \"metaDescription\": \"Mua nông sản Mộc Châu chính gốc\",\n  \"metaKeywords\": \"moc chau, nong san, htx\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            },
            "description": "POST /api/channels — lưu channelId từ response vào biến collection"
          }
        },
        {
          "name": "2. Tạo channel tối thiểu",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channelSlug\": \"cua-hang-demo\",\n  \"channelName\": \"Cửa hàng Demo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            }
          }
        },
        {
          "name": "ERROR: channelSlug rỗng",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channelSlug\": \"\",\n  \"channelName\": \"Test Channel\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            },
            "description": "Kỳ vọng 400 validation"
          }
        },
        {
          "name": "ERROR: slug không hợp lệ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channelSlug\": \"Slug_Khong_Hop_Le\",\n  \"channelName\": \"Test Channel\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            },
            "description": "Kỳ vọng 400 — slug chỉ [a-z0-9-]"
          }
        },
        {
          "name": "ERROR: Store đã có channel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channelSlug\": \"slug-trung-lap-store\",\n  \"channelName\": \"Channel thứ hai\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            },
            "description": "Kỳ vọng 400 — mỗi store chỉ 1 channel"
          }
        },
        {
          "name": "ERROR: Slug đã tồn tại (hệ thống)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channelSlug\": \"{{channelSlug}}\",\n  \"channelName\": \"Trùng slug toàn cục\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            },
            "description": "Kỳ vọng 400 khi slug đã dùng bởi store khác (cần user/store chưa có channel)"
          }
        }
      ]
    },
    {
      "name": "UPDATE",
      "item": [
        {
          "name": "1. Cập nhật tất cả các trường",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channelSlug\": \"{{channelSlug}}\",\n  \"channelName\": \"HTX Mộc Châu - Đã cập nhật\",\n  \"shortDescription\": \"Mô tả ngắn mới\",\n  \"description\": \"<p>Mô tả HTML mới</p>\",\n  \"bannerUrl\": \"https://example.com/images/banner-new.jpg\",\n  \"logoUrl\": \"https://example.com/images/logo-new.png\",\n  \"videoUrl\": \"https://example.com/videos/intro-new.mp4\",\n  \"storyContent\": \"<p>Câu chuyện cập nhật</p>\",\n  \"originStory\": \"<p>Nguồn gốc cập nhật</p>\",\n  \"themeSettings\": \"{\\\"primaryColor\\\": \\\"#1565C0\\\", \\\"secondaryColor\\\": \\\"#FF5722\\\"}\",\n  \"isActive\": true,\n  \"isFeatured\": true,\n  \"metaTitle\": \"HTX Mộc Châu - SEO Title\",\n  \"metaDescription\": \"Meta description mới\",\n  \"metaKeywords\": \"moc chau, dac san\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/{{channelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{channelId}}"]
            }
          }
        },
        {
          "name": "2. Cập nhật chỉ channelName",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channelName\": \"Tên channel mới\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/{{channelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{channelId}}"]
            }
          }
        },
        {
          "name": "3. Bật featured",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isFeatured\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/{{channelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{channelId}}"]
            },
            "description": "Sau đó gọi GET /featured để kiểm tra"
          }
        },
        {
          "name": "4. Deactivate channel (isActive = false)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/{{channelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{channelId}}"]
            },
            "description": "GET public theo slug sẽ 404; GET / và /featured không còn hiển thị"
          }
        },
        {
          "name": "5. Kích hoạt lại channel",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/{{channelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{channelId}}"]
            }
          }
        },
        {
          "name": "ERROR: Channel không tồn tại",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channelName\": \"Test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/99999",
              "host": ["{{baseUrl}}"],
              "path": ["99999"]
            },
            "description": "Kỳ vọng 400"
          }
        },
        {
          "name": "ERROR: Slug trùng channel khác",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channelSlug\": \"slug-cua-channel-khac\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/{{channelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{channelId}}"]
            },
            "description": "Kỳ vọng 400 khi slug đã thuộc channel khác"
          }
        }
      ]
    },
    {
      "name": "DELETE",
      "item": [
        {
          "name": "1. Xóa channel (soft delete)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{channelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{channelId}}"]
            },
            "description": "DELETE /api/channels/{id} — set isActive = false. Tạo lại channel mới cần store chưa có channel hoặc xử lý nghiệp vụ riêng."
          }
        },
        {
          "name": "ERROR: Channel không tồn tại",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/99999",
              "host": ["{{baseUrl}}"],
              "path": ["99999"]
            },
            "description": "Kỳ vọng 400"
          }
        },
        {
          "name": "ERROR: Không có quyền (channel store khác)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/99998",
              "host": ["{{baseUrl}}"],
              "path": ["99998"]
            },
            "description": "Kỳ vọng 400 — id tồn tại nhưng không thuộc store của user (đổi id phù hợp môi trường test)"
          }
        }
      ]
    }
  ]
}
