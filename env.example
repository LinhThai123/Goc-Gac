# ============================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ============================================
# Copy this file to .env and update with your actual values
# cp env.example .env
#
# IMPORTANT: Never commit .env file to version control
# ============================================

# ============================================
# POSTGRESQL DATABASE CONFIGURATION
# ============================================
POSTGRES_DB=gocgac
POSTGRES_USER=postgres
POSTGRES_PASSWORD=gocgac123
POSTGRES_PORT=5433

# Keycloak Database
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=keycloak_password_123

# ============================================
# SPRING APPLICATION CONFIGURATION
# ============================================
# Database Connection (used by Spring Boot application)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/gocgac
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=gocgac123

# ============================================
# KEYCLOAK CONFIGURATION
# ============================================
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# Keycloak Client Secret (used by Spring Boot application)
KEYCLOAK_CLIENT_SECRET=SxCZ1IJQNvKtA1vl548BoGUXONhBZU5l
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# Keycloak Auth Server URL (for production)
# KEYCLOAK_AUTH_SERVER_URL=https://keycloak.yourdomain.com

# ============================================
# EMAIL CONFIGURATION
# ============================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password

# ============================================
# MINIO OBJECT STORAGE CONFIGURATION
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO Configuration (used by Spring Boot application)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=gocgac
MINIO_URL=http://localhost:9000

# ============================================
# ELASTICSEARCH CONFIGURATION
# ============================================
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300
ELASTICSEARCH_URIS=http://localhost:9200

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Frontend URL
APP_FRONTEND_URL=http://localhost:4202

# Social Login Password Secret
SOCIAL_PASSWORD_SECRET=change-me-to-secure-random-string

# Google OAuth Client ID
GOOGLE_CLIENT_ID=your-google-client-id

# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Uncomment and configure for production deployment

# Spring Security OAuth2 (Production)
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://keycloak.yourdomain.com/realms/gocgac-htx
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=https://keycloak.yourdomain.com/realms/gocgac-htx/protocol/openid-connect/certs

# Server Port (Production)
# SERVER_PORT=8086

# Log File Path (Production)
# LOG_FILE_PATH=/var/log/gocgac

# ============================================
# NOTES
# ============================================
# 1. For Gmail SMTP, you need to:
#    - Enable 2-factor authentication
#    - Generate an App Password (not your regular password)
#    - Use the App Password in SPRING_MAIL_PASSWORD
#
# 2. For production:
#    - Use strong, unique passwords
#    - Use HTTPS URLs for Keycloak
#    - Store secrets securely (use secrets management tools)
#    - Never commit .env file to version control
#
# 3. Default values in docker-compose.yml and application.yml
#    will be used if environment variables are not set
# ============================================

